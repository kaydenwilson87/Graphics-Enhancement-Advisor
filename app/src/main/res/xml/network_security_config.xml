<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain http ONLY for the emulator's address of the computer running the Django server.
     Once the backend is hosted with https this is no longer needed. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
