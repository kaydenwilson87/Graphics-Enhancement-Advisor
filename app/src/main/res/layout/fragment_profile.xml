<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:id="@+id/tvAvatar" android:layout_width="64dp" android:layout_height="64dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="24dp"
        android:background="@drawable/bg_avatar" android:gravity="center"
        android:textSize="26sp" android:textStyle="bold" android:textColor="@color/black" />
    <TextView android:id="@+id/tvName" style="@style/Heading" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" />
    <TextView android:id="@+id/tvEmail" style="@style/Caption" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" />
    <TextView android:id="@+id/tvRole" style="@style/Caption" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btnManageGpus"
        style="@style/AppButton.Secondary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="32dp"
        android:text="@string/manage_gpus_admin" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnManageGames"
        style="@style/AppButton.Secondary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/manage_games_admin" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnSignOut"
        style="@style/AppButton.Secondary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/sign_out" android:textColor="#FFFF0000" />
</LinearLayout>
