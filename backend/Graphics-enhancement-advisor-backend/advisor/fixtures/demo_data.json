 },
 {
  "model": "advisor.researchevidence",
  "pk": 2,
  "fields": {
   "technology": 2,
   "game": null,
   "gpu": null,
   "resolution": "",
   "source_title": "AMD FSR",
   "source_url": "https://www.amd.com/en/products/graphics/technologies/fidelityfx/super-resolution.html?",
   "publisher": "AMD",
   "published_at": null,
   "findings": "FSR's important advantage has historically been broad hardware compatibility. However, current generations have different requirements, meaning that an application cannot treat FSR as a single feature. Newer ML-powered FSR features target newer Radeon hardware, while earlier versions retain wider compatibility",
   "limitations": "A second limitation is version dependence. DLSS, FSR and XeSS are continuously evolving, so older findings may not represent current releases. Current vendor documentation confirms substantial ongoing development in all three technologies.",
   "preference": "balanced",
   "performance_score": 4,
   "image_quality_score": 3,
   "latency_score": 4,
   "confidence": 2,
   "is_active": true,
   "created_at": "2026-10-21T00:00:00Z",
